import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# 宿主机侧 API 非法暴露检查工具：
# 加载 native so，提取运行时导出面并与合法API列表比对
ohos_executable("checkapi") {
  use_exceptions = true

  sources = [
    "check_api.cpp",
    "check_helper.cpp",
    "check_match.cpp",
    "load_so.cpp",
    "parse_json.cpp",
  ]

  include_dirs = [ "." ]

  # 链接 libace_napi.so：保证 requireNapi/native_module_manager 与被检查 so 共享同一实例；
  # ace_napi 的 public_configs 会传播本仓库头文件与平台宏（LINUX_PLATFORM/OHOS_PLATFORM 等）
  deps = [ "//foundation/arkui/napi:ace_napi" ]

  external_deps = [
    "cJSON:cjson",
    "ets_runtime:libark_jsruntime",
  ]

  # 设备侧（OHOS 标准系统）编译时 utils/log.h 走 hilog 分支（#include
  # "hilog/log.h"），需声明 hilog 依赖提供头文件路径与链接；宿主机侧
  # （LINUX_PLATFORM 等）走 PrintLog 分支不需要。守卫与主 BUILD.gn 中
  # ace_napi 的平台分支条件保持一致。
  if (!is_mingw && !is_mac && !is_linux && is_ohos_standard_system) {
    external_deps += [ "hilog:libhilog" ]
  }

  subsystem_name = "arkui"
  part_name = "napi"
}

# 样例端到端测试（so），按需构建：
#   ninja -C out/<dir> checkapi_samples
group("checkapi_samples") {
  deps = [ "sample:run_test" ]
}
