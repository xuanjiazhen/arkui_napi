import("./config.gni")
import("./sample/test_list.gni")

config("tools_config") {
  defines = []
  cflags_cc = []

  if (is_debug) {
    cflags_cc += [
      "-O0",
      "-ggdb3",
      "-gdwarf-4",
    ]
  } else {
    defines += [ "NDEBUG" ]
  }

  if (is_ohos) {
    defines += [ "OHOS_PLATFORM" ]
  }
}

ohos_source_set("tools_source_set") {
  include_dirs = [
    "."
  ]

  configs = [ ":tools_config" ]

  sources = [
    "load_so.cpp",
    "load_abc.cpp",
    "parse_json.cpp",
    "check_api.cpp",
    "check_helper.cpp"
  ]

  deps = []
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "ets_runtime:libark_jsruntime",
    "napi:ace_napi",
  ]

  part_name = "test"
  subsystem_name = "test" 
}

ohos_executable("checkapi") {
  sources = [ "main.cpp" ]
  deps = [ "./:tools_source_set" ]

  external_deps = [
    "napi:ace_napi",
  ]

  configs = [ ":tools_config" ]

  install_enable = false

  part_name = "test"
  subsystem_name = "test"
}

group("run_checkapi") {
  deps = [ "./sample:run_test" ]
}