import("../test_list.gni")
import("//build/config/components/ets_frontend/es2abc_config.gni")

foreach(test, abc_test_list) {
    case = test.case
    index = test.index
    _test_js_path_ = "${case}/${case}.js"
    _test_json_path_ = "${case}/${case}.json"

    _host_checkapi_target_ = "../..:checkapi"
    _root_out_dir_ = get_label_info(_host_checkapi_target_, "root_out_dir")

    _test_abc_path_ = "${_root_out_dir_}/checkapi/sample/${case}_${index}/${case}.abc"
    _result_path_ = "${_root_out_dir_}/checkapi/sample/${case}_${index}/result.json"

    es2abc_gen_newest_abc("gen_${case}_${index}") {
        extra_visibility = [ ":*" ] # Only targets in this file can depend on this.
        extra_dependencies = []
        src_js = rebase_path(_test_js_path_)
        dst_file = rebase_path(_test_abc_path_)
        extra_args = []

        if (test.__is_module) {
            extra_args += [ "--module" ]
        }
        if (test.__is_commonjs) {
            extra_args += [ "--commonjs" ]
        }
        if (test.__is_merge) {
            extra_args += [ "--merge-abc" ]
        }

        if (test.__is_merge) {
            #extra_dependencies = [ ":gen_${_target_name_}_merge_file" ]
            #src_js = "@" + rebase_path(_merge_file)
            #in_puts = [
            #   merge_file,
            #]
        } else {
            in_puts = [
                _test_js_path_,
            ]
        }
        out_puts = [ _test_abc_path_ ]
    }

    action("run_${case}_${index}") {
        deps = [
            _host_checkapi_target_,
            ":gen_${case}_${index}"
        ]

        inputs = [
            _test_js_path_,
            _test_abc_path_,
            _test_json_path_
        ]

        # run_check.py <checkapi> <root_out_dir> <kit> <file> <legal json> <result json>
        args = [
            rebase_path("${_root_out_dir_}/arkui/napi/checkapi"),
            rebase_path("${_root_out_dir_}"),
            case,
            rebase_path(_test_abc_path_),
            rebase_path(_test_json_path_),
            rebase_path(_result_path_),
        ]

        script = "../../run_check.py"

        outputs = [ _result_path_ ]
    }
}
