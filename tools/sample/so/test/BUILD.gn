import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# 编译node-API动态库（宿主机侧被检查样例模块）
ohos_shared_library("test") {
    sources = [ "test.cpp" ]

    # node-api依赖：public_configs 传播 napi 头文件路径与平台宏
