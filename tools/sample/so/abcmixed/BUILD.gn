import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# 混合 so 回归样例：内嵌 ArkTS ABC（GetABCCode 符号），不调用
# napi_module_register——锁定 ABC 备选通道（requireNapi 失败后直接
# 提取+执行）。abctest.h 由构建时 es2abc 产物生成（手动预生成入库）
ohos_shared_library("abcmixed") {
    sources = [ "abcmixed.cpp" ]

    include_dirs = [ "." ]

    deps = [ "../../../..:ace_napi" ]

    subsystem_name = "arkui"
    part_name = "napi"
}
