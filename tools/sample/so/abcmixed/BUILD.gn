import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# Mixed .so sample: embedded ABC, no napi_module_register (locks the ABC fallback; see
# run_abcmixed in ../BUILD.gn). abctest.h is pre-generated from the es2abc output.
ohos_shared_library("abcmixed") {
    sources = [ "abcmixed.cpp" ]

    include_dirs = [ "." ]

    deps = [ "../../../..:ace_napi" ]

    subsystem_name = "arkui"
    part_name = "napi"
}
