import("//build/config/clang/clang.gni")
import("//build/ohos.gni")

ohos_prebuilt_shared_library("libjsvm") {
  deps = [ ":build_libjsvm" ]

  source = "$target_gen_dir/libjsvm.so"
  subsystem_name = "arkui"
  part_name = "napi"

  install_enable = true
  install_images = [ "system" ]
  innerapi_tags = [ "ndk" ]
}

ohos_ndk_library("libjsvm_ndk") {
  ndk_description_file = "interfaces/libjsvm.ndk.json"
  min_compact_version = "1"
  output_name = "jsvm"
  output_extension = "so"
}

ohos_ndk_headers("jsvm_header") {
  dest_dir = "$ndk_headers_out_dir/ark_runtime"
  sources = [
    "interfaces/jsvm.h",
    "interfaces/jsvm_types.h",
  ]
}

action("build_libjsvm") {
  deps = [ "//third_party/musl:musl_all" ]
  script = "build_jsvm.sh"
  sources = [ "interfaces/jsvm.h" ]
  outputs = [ "$target_gen_dir/libjsvm.so" ]
  args = [
    "--target_gen_dir",
    rebase_path("$target_gen_dir"),
    "--target_cpu",
    "$target_cpu",
    "--prefix",
    rebase_path("$clang_base_path/bin"),
    "--sysroot",
    rebase_path("$musl_sysroot"),
  ]
}
