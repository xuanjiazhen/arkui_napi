import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")
import("//foundation/arkui/ace_engine/frameworks/bridge/cj_frontend/platform.gni")

config("ffi_bind_native_config") {
  include_dirs = [ "native" ]
  if (is_ohos_standard_system) {
    include_dirs += [ "//commonlibrary/c_utils/base/include" ]
  }
  cflags_cc = [ "-std=c++17" ]
}

ohos_shared_library("cj_bind_native") {
  public_configs = [ ":ffi_bind_native_config" ]

  cflags_cc = [
    "-fdata-sections",
    "-ffunction-sections",
  ]

  sources = [
    "//commonlibrary/c_utils/base/src/refbase.cpp",
    "native/cj_fn_invoker.cpp",
    "native/ffi_remote_data.cpp",
    "native/cj_collection_ffi.cpp",
  ]

  include_dirs = [
    "$ace_root/frameworks",
    "//arkcompiler/cj/cj_systemapi/interfaces/ffi_bind",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
  ]

  external_deps = [ "hilog:libhilog" ]
  if (platform_config.is_ohos) {
    external_deps += [ "c_utils:utils" ]
  }


  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "arkui"
  part_name = "napi"
}

ohos_source_set("cj_bind_ffi_source") {
  sources = [
    "cj_ffi/cj_common_ffi.cpp",
    "cj_ffi/cj_data_ffi.cpp",
  ]
  public_deps = [ ":cj_bind_native" ]
  include_dirs = [
    "cj_ffi",
    "native"
  ]

  subsystem_name = "arkui"
  part_name = "napi"
}

config("ffi_bind_ffi_public_config") {
  include_dirs = [ "cj_ffi" ]
  cflags_cc = [ "-std=c++17" ]
}

